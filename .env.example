# Copy to .env and paste your NEAR AI Cloud key (starts with sk-). Claim one at https://nearbuilders.org/dashboard
NEAR_API_KEY=

# --- Optional settings (all commented out = safe defaults) ---
# NEAR_MODEL=z-ai/glm-5.3-flash          # any Confidential TEE model (owned_by=nearai in GET https://cloud-api.near.ai/v1/models)
# PORT=3000                              # port to listen on (0 = pick a free port)
# HOST=127.0.0.1                         # bind address; default is loopback only, keep it that way for privacy
# ALLOWED_HOSTS=                         # extra comma-separated Host header names to accept (default: localhost, 127.0.0.1, [::1])
# NEAR_TIMEOUT_MS=90000                  # max wait for the model's answer before INFERENCE_TIMEOUT
# ASCII_SAFE_JSON=1                      # 1 = send the request as pure-ASCII JSON (\uXXXX); 0 = raw UTF-8
# EXPECTED_COMPOSE_HASH=                 # sha256 hex of the model enclave's app_compose; pins the enclave software (fails verification on mismatch)
# ALLOW_ENDPOINT_OVERRIDE=0              # 1 = allow NEAR_BASE_URL / NRAS_URL / NRAS_JWKS_URL / PCCS_URL overrides (development only; shown as a /api/health warning)

# Offline demo / tests: `npm run twin` (simulated NEAR; TWIN_SCRIPT=tampered_res etc.), `npm test`

# --- Hosted public demo (see Dockerfile / docker-compose.yml) ---
# HOSTED_DEMO=1                          # bundled fictional samples only (403 SAMPLES_ONLY otherwise), per-IP + daily rate limits (429 RATE_LIMITED)
# TRUST_PROXY=1                          # behind a reverse proxy: client IP = right-most X-Forwarded-For (default 0: ignore the header)
# DEMO_ANALYZE_LIMIT=5                   # analyses per IP per window
# DEMO_ASK_LIMIT=20                      # follow-ups per IP per window
# DEMO_WINDOW_MS=600000                  # rate-limit window (10 min)
# DEMO_DAILY_CAP=200                     # global analyses+follow-ups per UTC day
# A non-loopback HOST is refused unless HOSTED_DEMO=1, which also requires ALLOWED_HOSTS=<public hostname>.
