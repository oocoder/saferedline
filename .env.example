# Copy to .env and paste your NEAR AI Cloud key (starts with sk-). Claim one at https://nearbuilders.org/dashboard
NEAR_API_KEY=sk-your-key-here
# Optional: any Confidential TEE model (owned_by=nearai in GET https://cloud-api.near.ai/v1/models)
# NEAR_MODEL=z-ai/glm-5.3-flash
# PORT=3000
# Optional: HOST=127.0.0.1 (default; loopback only), NEAR_TIMEOUT_MS=90000, ASCII_SAFE_JSON=1 (set 0 to send raw UTF-8)
# Optional pin: EXPECTED_COMPOSE_HASH=<sha256 hex of the attested app_compose>
# Offline demo / tests: npm run twin   (TWIN_SCRIPT=tampered_res etc.)
