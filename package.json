{
  "name": "safe-redline",
  "version": "1.0.0",
  "description": "SafeRedline: zero-leak contract & NDA reviewer running on NEAR AI Cloud TEEs with cryptographic attestation",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "verify": "node scripts/verify_tee.mjs",
    "test": "node --test tests/*.test.mjs",
    "twin": "node scripts/twin.mjs",
    "record": "node scripts/record_fixtures.mjs",
    "check:docs": "node scripts/check_docs.mjs",
    "prove": "node scripts/verify_tee.mjs --json",
    "e2e": "node tests/e2e/ui.e2e.mjs",
    "demo:record": "node tests/e2e/record_demo.mjs",
    "check:receipt": "node scripts/verify_tee.mjs --check",
    "verify:server": "node scripts/verify_server.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@phala/dcap-qvl": "^0.7.1",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
